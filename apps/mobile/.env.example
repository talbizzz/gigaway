# Copy to .env and fill in from the Supabase project.
#
# EXPO_PUBLIC_* values are embedded in the app bundle and are readable by anyone
# who downloads the app. Never put a secret here — the Supabase anon key is
# designed to be public and is safe only because RLS is enforced on every table.

# Supabase cloud project (`supabase projects api-keys --project-ref <ref>`).
# Use the anon key, never the service_role/secret key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Observability
EXPO_PUBLIC_SENTRY_DSN=

# Analytics — stays false until the published privacy policy names PostHog.
# See Milestone 5. The client is a no-op unless this is exactly "true".
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Legal pages
EXPO_PUBLIC_WEB_BASE_URL=https://gigaway.app

# Universal Link path Supabase Auth redirects to after a confirmation or
# password-recovery email is followed. Prod and the dev variant claim
# different paths on the same domain so both can stay installed on one test
# device — see Milestone-5-Ship-It.md, "Corrections made during
# implementation" 5. This file's default is prod's path; .env.dev overrides
# it to /auth/dev-callback.
EXPO_PUBLIC_AUTH_CALLBACK_PATH=/auth/callback
