# Copy to .env and fill in from whichever Supabase project you want to test
# against locally (almost always dev). Vite loads plain .env in every mode.
#
# VITE_* variables are baked into the built JS bundle at build time and are
# visible to anyone who opens the deployed site — same as the mobile app's
# EXPO_PUBLIC_* variables. The anon key is not a secret; RLS and is_admin()
# are what actually gate access. Never put the service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Shown as a persistent banner in the UI so an admin always knows which
# environment they're acting against. Leave unset in prod.
VITE_ENV_LABEL=dev
