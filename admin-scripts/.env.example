# Copy to .env.dev and/or .env.prod (both gitignored) and fill in from the
# matching Supabase project's Settings -> API.
#
# Unlike apps/*/.env, this is the SERVICE ROLE key — full access, bypasses
# RLS, and can create and delete auth users. It must never leave this
# machine: no commit, no chat, no CI secret for a script that is run by hand.
#
# Every script checks that SUPABASE_URL belongs to the project named by its
# --env flag before it does anything, so a prod key pasted into .env.dev is
# refused rather than obeyed.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role / secret key>
