{
  "name": "gigaway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:legal": "node scripts/build-legal.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "sync:shared:check": "node scripts/sync-shared.mjs --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "db:test": "supabase test db --linked",
    "db:types": "supabase gen types typescript --linked > packages/shared/src/types/database.types.ts",
    "functions:deploy": "pnpm sync:shared && node scripts/sync-function-configs.mjs && supabase functions deploy --use-api",
    "create-admin": "node admin-scripts/scripts/create-admin.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "marked": "^18.0.11",
    "typescript": "^5.7.2"
  }
}
