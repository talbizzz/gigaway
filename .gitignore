# generated by `./scripts/build-icons.sh` from apps/mobile/assets/images/
store/play/icon-512.png
store/play/feature-graphic.png

# generated by `./store/play/pad-screenshots.sh` from store/play/app-screenshots/
store/play/screenshots/

# local credentials for the dev Supabase project — never commit
.gigaway-dev-credentials*

# Local copies of React Native prebuilt artifacts, kept because
# repo.reactnative.dev intermittently 404s. Large; never commit.
apps/mobile/.rn-artifacts/
